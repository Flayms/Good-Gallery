{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build app",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "app"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo build app (release)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "app", "--release"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    }
  ]
}
