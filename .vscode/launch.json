{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Good Gallery (debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/app.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "environment": [
        { "name": "GOOD_GALLERY_EXIFTOOL", "value": "${workspaceFolder}\\target\\helpers\\exiftool\\exiftool.exe" },
        { "name": "GOOD_GALLERY_FFMPEG", "value": "${workspaceFolder}\\target\\helpers\\ffmpeg\\ffmpeg.exe" },
        { "name": "GOOD_GALLERY_MPV", "value": "${workspaceFolder}\\target\\helpers\\mpv\\libmpv-2.dll" }
      ],
      "preLaunchTask": "cargo build app"
    },
    {
      "name": "Good Gallery (release)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/release/app.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "environment": [
        { "name": "GOOD_GALLERY_EXIFTOOL", "value": "${workspaceFolder}\\target\\helpers\\exiftool\\exiftool.exe" },
        { "name": "GOOD_GALLERY_FFMPEG", "value": "${workspaceFolder}\\target\\helpers\\ffmpeg\\ffmpeg.exe" },
        { "name": "GOOD_GALLERY_MPV", "value": "${workspaceFolder}\\target\\helpers\\mpv\\libmpv-2.dll" }
      ],
      "preLaunchTask": "cargo build app (release)"
    }
  ]
}