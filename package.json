{
  "name": "good-gallery",
  "version": "0.1.0",
  "private": true,
  "description": "Modern masonry gallery with network-drive thumbnail caching and tag search",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false && tsc -p tsconfig.e2e.json --noEmit --composite false",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "db:generate": "drizzle-kit generate",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "~5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-plugin": "1.168.40",
    "@trpc/client": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@trpc/server": "^11.19.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "~0.45.2",
    "exiftool-vendored": "~38.1.0",
    "ffmpeg-static": "^5.3.0",
    "p-queue": "^9.3.3",
    "sharp": "~0.35.4",
    "superjson": "^2.2.6",
    "thumbhash": "^0.1.1",
    "zod": "^4.6.5"
  }
}
